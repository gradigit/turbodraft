{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "winner": {
      "type": "string",
      "enum": ["A", "B", "Tie"]
    },
    "score_a": {
      "type": "number",
      "minimum": 0
    },
    "score_b": {
      "type": "number",
      "minimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 6
    },
    "penalties_a": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "penalties_b": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "winner",
    "score_a",
    "score_b",
    "confidence",
    "reasons",
    "penalties_a",
    "penalties_b"
  ],
  "additionalProperties": false
}
